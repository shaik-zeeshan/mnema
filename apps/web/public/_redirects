/agents /agents/ 301
/alternatives /alternatives/ 301
/alternatives/limitless /alternatives/limitless/ 301
/alternatives/microsoft-recall-mac /alternatives/microsoft-recall-mac/ 301
/alternatives/rewind-ai /alternatives/rewind-ai/ 301
/alternatives/screenpipe /alternatives/screenpipe/ 301
/license/devices /license/devices/ 301
/license/open /license/open/ 301
/pricing /pricing/ 301
/privacy /privacy/ 301
/support /support/ 301
