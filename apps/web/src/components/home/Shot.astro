---
// An app window screenshot in the .w-shot frame: one image per theme, CSS
// shows the right one (the hidden twin is lazy, so it never downloads).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  dark: ImageMetadata;
  light: ImageMetadata;
  alt: string;
  sizes: string;
  class?: string;
}

const { dark, light, alt, sizes, class: className } = Astro.props;
const widths = [960, 1440, 1920];
---

<figure class:list={["w-shot", className]}>
  <div class="w-shot__lights"><i></i><i></i><i></i></div>
  <Image class="w-dark" src={dark} alt={alt} widths={widths} sizes={sizes} />
  <Image class="w-light" src={light} alt="" widths={widths} sizes={sizes} />
</figure>

<style>
  .w-shot { margin: 0; }
</style>
