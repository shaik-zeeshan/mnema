---
import ThemeToggle from "./ThemeToggle.astro";
import { DOWNLOAD_URL } from "../config";

const links = [
  { href: "/#recall", label: "Recall" },
  { href: "/#ask", label: "Ask" },
  { href: "/#insights", label: "Insights" },
  { href: "/#privacy", label: "Privacy" },
  { href: "/agents/", label: "Agents" },
  { href: "/pricing/", label: "Pricing" },
];

// The page's own link reads as selected (mx-btn--ghost styles aria-current).
const path = Astro.url.pathname.replace(/\/?$/, "/");
---

<header class="w-nav">
  <div class="w-wrap w-nav__in">
    <a class="w-brand" href="/"><img src="/icon.png" alt="" width="22" height="22" />mnema</a>
    <nav class="w-nav__links" aria-label="Main">
      {
        links.map(({ href, label }) => (
          <a class="mx-btn mx-btn--ghost" href={href} aria-current={href === path ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <span class="mx-spacer"></span>
    <ThemeToggle />
    <a
      class="mx-btn mx-btn--primary"
      href={DOWNLOAD_URL}
      data-umami-event="download"
      data-umami-event-source="topbar">Download</a
    >
  </div>
</header>
