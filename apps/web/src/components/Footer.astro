---
import { DOWNLOAD_URL, GITHUB_URL } from "../config";

type Link = { href: string; label: string; attrs?: Record<string, string> };

const columns: { title: string; links: Link[] }[] = [
  {
    title: "Product",
    links: [
      {
        href: DOWNLOAD_URL,
        label: "Download",
        attrs: { "data-umami-event": "download", "data-umami-event-source": "footer" },
      },
      { href: "/pricing/", label: "Pricing" },
      { href: "/agents/", label: "Agents" },
    ],
  },
  {
    title: "Compare",
    links: [
      { href: "/alternatives/rewind-ai/", label: "Rewind alternative" },
      { href: "/alternatives/microsoft-recall-mac/", label: "Recall for Mac" },
      { href: "/alternatives/screenpipe/", label: "Screenpipe alternative" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/support/", label: "Support" },
      { href: "/privacy/", label: "Privacy" },
      { href: GITHUB_URL, label: "GitHub", attrs: { target: "_blank", rel: "noopener noreferrer" } },
    ],
  },
];

const path = Astro.url.pathname.replace(/\/?$/, "/");
---

<footer class="w-foot">
  <div class="w-wrap">
    <div class="w-foot__in">
      <div class="w-stack">
        <a class="w-brand" href="/"><img src="/icon.png" alt="" width="22" height="22" />mnema</a>
        <p class="w-prose">A private, searchable memory of your Mac.</p>
      </div>
      {
        columns.map(({ title, links }) => (
          <div>
            <h4>{title}</h4>
            <ul>
              {links.map(({ href, label, attrs }) => (
                <li>
                  <a href={href} aria-current={href === path ? "page" : undefined} {...attrs}>
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="w-foot__base w-meta">
      <span class="w-foot__lic">
        <a href={`${GITHUB_URL}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">AGPL-3.0</a>
        <span aria-hidden="true">·</span>
        <!-- Base.astro upgrades "latest" to the current version from the stable feed. -->
        <span data-latest-release-version>latest</span>
      </span>
      <span>no cookies · anonymous analytics</span>
    </div>
  </div>
</footer>

<style>
  .w-prose {
    font-size: 14px;
  }

  .w-foot__lic {
    display: inline-flex;
    gap: var(--s-2);
  }

  /* The base row stays in the mono meta voice; .w-foot a would make it 14px sans. */
  .w-foot__base a {
    font: inherit;
    color: inherit;
  }

  .w-foot__base a:hover {
    color: var(--app-text-strong);
  }
</style>
