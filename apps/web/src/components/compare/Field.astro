---
// The comparison table. Column 0 is always Mnema and carries the selected
// wash. On a phone each row stacks into label/value pairs (data-col).
import type { FieldTable } from "./types";

type Props = FieldTable;

const { columns, rows, note } = Astro.props;
---

<table class="field">
  <thead>
    <tr>
      <th scope="col"><span class="sr-only">Feature</span></th>
      {columns.map((col, i) => <th scope="col" class:list={{ us: i === 0 }}>{col}</th>)}
    </tr>
  </thead>
  <tbody>
    {
      rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {row.cells.map((cell, i) => (
            <td class:list={{ us: i === 0, none: cell === "—" }} data-col={columns[i]}>
              {cell}
            </td>
          ))}
        </tr>
      ))
    }
  </tbody>
</table>
<p class="w-meta note">{note}</p>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .field { width: 100%; border-collapse: collapse; margin-top: var(--s-3); font-size: 14px; }
  .field th, .field td { text-align: left; vertical-align: top; padding: 11px 14px; border-top: 1px solid var(--mx-hairline); }
  .field thead th { border-top: 0; padding-block: 10px; font: 500 var(--text-xs)/1.3 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--app-text-subtle); border-bottom: 1px solid var(--app-border-strong); }
  .field tbody tr:first-child > * { border-top: 0; }
  .field tbody th { font: 450 12px/1.5 var(--font-mono); color: var(--app-text-subtle); white-space: nowrap; padding-left: 0; padding-top: 13px; }
  .field td { color: var(--app-text-muted); line-height: 1.5; }
  .field .us { background: var(--mx-selected); color: var(--app-text-strong); }
  .field thead .us { color: var(--app-accent); border-radius: var(--r-sm) var(--r-sm) 0 0; }
  .field tbody tr:last-child .us { border-radius: 0 0 var(--r-sm) var(--r-sm); }
  .field .none { color: var(--app-text-faint); }
  .note { color: var(--app-text-subtle); max-width: 72ch; margin: 0; }
  @media (max-width: 720px) {
    .field thead { display: none; }
    .field, .field tbody, .field tr, .field th, .field td { display: block; }
    .field tr { padding: var(--s-4) 0; border-top: 1px solid var(--mx-hairline); }
    .field tbody tr:first-child { border-top: 0; }
    .field tbody th { padding: 0 0 var(--s-2); white-space: normal; }
    .field td { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--s-3); padding: 7px 10px; border-top: 0; }
    .field td::before { content: attr(data-col); font: 450 12px/1.5 var(--font-mono); color: var(--app-text-subtle); }
    .field .us { border-radius: var(--r-sm) !important; }
    .field .us::before { color: var(--app-accent); }
  }
</style>
