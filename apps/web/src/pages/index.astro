---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Hero from "../components/home/Hero.astro";
import Timeline from "../components/home/Timeline.astro";
import Features from "../components/home/Features.astro";
import Extras from "../components/home/Extras.astro";
import Privacy from "../components/home/Privacy.astro";
import AgentsPointer from "../components/home/AgentsPointer.astro";
import Cta from "../components/home/Cta.astro";
import Footer from "../components/Footer.astro";
import { DOWNLOAD_URL, GITHUB_URL } from "../config";

const orgJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Mnema",
  url: "https://mnema.day",
  logo: "https://mnema.day/icon.png",
  // Official profiles — tells search engines which "Mnema" this site is.
  sameAs: [GITHUB_URL],
});

const appJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Mnema",
  operatingSystem: "macOS",
  applicationCategory: "UtilitiesApplication",
  description:
    "Mnema records your screen, audio, and activity into a private, searchable record you can scrub, search, and ask an AI about — all on your Mac.",
  url: "https://mnema.day",
  downloadUrl: DOWNLOAD_URL,
  offers: {
    "@type": "Offer",
    price: "69",
    priceCurrency: "USD",
  },
});
---

<Base>
  <script type="application/ld+json" set:html={orgJsonLd} is:inline />
  <script type="application/ld+json" set:html={appJsonLd} is:inline />
  <TopBar />
  <main>
    <Hero />
    <Timeline />
    <Features />
    <Extras />
    <Privacy />
    <AgentsPointer />
    <Cta />
  </main>
  <Footer />
</Base>
