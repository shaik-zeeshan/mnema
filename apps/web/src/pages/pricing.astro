---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import { CHECKOUT_URL, DOWNLOAD_URL, PLATFORM_LABEL } from "../config";

const pageTitle = "mnema — pricing";
const pageDescription =
  "Mnema is a one-time $69 purchase with a year of updates included. 30-day free trial — no account, no card. Keep every version you own forever.";

const included = [
  {
    label: "30-day free trial first",
    detail: "No account, no card. The clock starts the first time you record — not when you install.",
  },
  {
    label: "One year of new builds",
    detail: "Every update released within a year of your purchase is yours.",
  },
  {
    label: "Keep it forever",
    detail: "The versions you own never expire, never need a subscription, never stop working.",
  },
  {
    label: "Everything included",
    detail: "Recall, Ask AI, Insights, agent access — no tiers, nothing metered.",
  },
  {
    label: "Verified on your Mac",
    detail: "Your license activates once per Mac, then it's verified on-device — no account, nothing personal sent.",
  },
];

const faq = [
  {
    q: "What happens when the trial ends?",
    a: "Mnema switches to read-only. Everything you recorded stays browsable, searchable, and Ask-AI-able — only new recording pauses until you buy.",
  },
  {
    q: "What happens after my year of updates?",
    a: "Nothing breaks. The app keeps working forever on the builds you own. If you want another year of new builds, renew for $29 — whenever you like, with no penalty for lapsing.",
  },
  {
    q: "Is there a subscription?",
    a: "No. $69 once. The optional $29 renewal is a purchase you make on your terms, not a plan that charges you.",
  },
  {
    q: "How many Macs can I use it on?",
    a: "Up to 3 at a time. Your license key is a signed string you paste into the app. Replaced a machine? Free up your old devices yourself from Settings, once every 30 days.",
  },
];

// Cheapest paid plan, billed yearly where the vendor offers it, read off each
// vendor's own pricing page. Re-check these before every copy change.
const yearly: [string, string, string][] = [
  ["Mnema", "$69 once", "then $29 a year only if you want new builds"],
  ["Otter Pro", "$100 a year", "per user"],
  ["Granola", "$168 a year", "$14 a month, per user"],
  ["Screenpipe", "$250 a year", "Basic plan"],
];
---

<Base title={pageTitle} description={pageDescription}>
  <TopBar />
  <main>
    <section class="hero w-texture">
      <div class="w-wrap">
        <span class="mx-kicker w-in">Pricing</span>
        <h1 class="w-display w-in" style="--d:60ms">Pay once. Own it.</h1>
        <p class="w-lede w-in" style="--d:120ms">
          Mnema is a one-time purchase, not a subscription. Try it free for 30 days, buy it once, and keep every version you own forever.
        </p>
        <p class="w-meta w-in" style="--d:150ms">one license · {PLATFORM_LABEL}</p>
      </div>
    </section>

    <section class="w-sec w-sec--rule lic-sec" aria-labelledby="license">
      <div class="w-wrap lic">
        <div class="mx-panel card">
          <div class="card__head">
            <div>
              <span class="mx-kicker" id="license">Mnema license</span>
              <p class="card__amt">$69<small>one-time</small></p>
            </div>
            <div class="card__acts">
              <a class="mx-btn mx-btn--primary w-btn-lg" href={CHECKOUT_URL} rel="noopener noreferrer">Buy Mnema — $69</a>
              <a
                class="mx-btn w-btn-lg"
                href={DOWNLOAD_URL}
                data-umami-event="download"
                data-umami-event-source="pricing"
                ><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 17V3"></path><path d="m6 11 6 6 6-6"></path><path d="M19 21H5"></path></svg>Try free for 30 days</a
              >
            </div>
          </div>
          <div class="card__body">
            <dl class="mx-spec">
              {
                included.map((item) => (
                  <div>
                    <dt class="tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    </dt>
                    <dt>{item.label}</dt>
                    <dd>{item.detail}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
        <div class="renew">
          <span class="mx-chip">+ $29/year, optional</span>
          <p class="w-prose">After your update window, renew only if you want another year of new builds. Your app never stops working either way.</p>
        </div>
        <div class="year" aria-labelledby="year-h">
          <h2 class="year__h" id="year-h">What a year costs</h2>
          <dl>
            {
              yearly.map(([name, price, note]) => (
                <div>
                  <dt>{name}</dt>
                  <dd class="year__amt">{price}</dd>
                  <dd>{note}</dd>
                </div>
              ))
            }
          </dl>
          <p class="w-meta">Prices from each vendor's own pricing page, November 2026. No acquisition can switch off an app already on your Mac.</p>
        </div>
      </div>
    </section>

    <section class="w-sec w-sec--rule" aria-labelledby="pricing-faq">
      <div class="w-wrap faq-grid">
        <div class="w-stack">
          <span class="mx-kicker">The fine print</span>
          <h2 class="w-title" id="pricing-faq">Questions people ask</h2>
        </div>
        <div class="faq">
          {
            faq.map((item, i) => (
              <details open={i === 0}>
                <summary>{item.q}</summary>
                <p>{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero { padding-top: clamp(56px, 9vw, 112px); padding-bottom: clamp(48px, 7vw, 88px); text-align: center; }
  .hero .w-display { max-width: 14ch; margin: var(--s-4) auto 0; }
  .hero .w-lede { margin: var(--s-4) auto 0; }
  .hero .w-meta { margin-top: var(--s-5); }

  .lic { max-width: 820px; margin: 0 auto; }
  .lic-sec { padding-top: clamp(48px, 6vw, 72px); }
  .card { overflow: hidden; }
  .card__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-5); padding: clamp(20px, 4vw, 32px); border-bottom: 1px solid var(--mx-hairline); }
  .card__amt { font: 400 clamp(48px, 7vw, 64px)/1 var(--font-mono); letter-spacing: -0.05em; color: var(--app-text-strong); margin: var(--s-3) 0 0; font-variant-numeric: tabular-nums; }
  .card__amt small { font: 500 14px/1 var(--font-mono); letter-spacing: 0; color: var(--app-text-subtle); margin-left: 8px; }
  .card__acts { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .card__body { padding: var(--s-2) clamp(20px, 4vw, 32px) var(--s-3); }
  .card .mx-spec { grid-template-columns: 22px minmax(170px, max-content) 1fr; }
  .card .mx-spec dt, .card .mx-spec dd { padding: 14px 0; }
  .card .mx-spec .tick { color: var(--app-accent); padding-right: 0; }
  .card .mx-spec .tick svg { width: 14px; height: 14px; display: block; margin-top: 3px; }
  .card .mx-spec dt:not(.tick) { color: var(--app-text-strong); font-weight: 600; font-size: 14px; }
  .card .mx-spec dd { color: var(--app-text-muted); font-size: 14px; line-height: 1.55; }
  @media (max-width: 640px) {
    .card .mx-spec { grid-template-columns: 22px 1fr; }
    .card .mx-spec dd { grid-column: 2; border-top: 0; padding-top: 0; }
    .card .mx-spec dt:not(.tick) { padding-bottom: 4px; }
  }
  .renew { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-2) var(--s-3); margin-top: var(--s-4); padding: 0 4px; }
  .renew .mx-chip { font-family: var(--font-mono); }
  .renew .w-prose { font-size: 14px; }

  .year { margin-top: var(--s-7); }
  .year__h { margin: 0 0 var(--s-3); font: 600 15px/1.35 var(--font-sans); color: var(--app-text-strong); }
  .year dl { margin: 0; border-top: 1px solid var(--mx-hairline); }
  .year dl > div { display: grid; grid-template-columns: minmax(110px, 160px) minmax(120px, 160px) 1fr; gap: var(--s-4); padding: 12px 0; border-bottom: 1px solid var(--mx-hairline); font-size: 14px; }
  .year dt { color: var(--app-text-strong); font-weight: 600; }
  .year dd { margin: 0; color: var(--app-text-muted); }
  .year .year__amt { font-family: var(--font-mono); color: var(--app-text-strong); font-variant-numeric: tabular-nums; }
  .year .w-meta { margin-top: var(--s-3); }
  @media (max-width: 640px) {
    .year dl > div { grid-template-columns: 1fr auto; gap: 2px var(--s-4); }
    .year dl > div dd:last-child { grid-column: 1 / -1; }
  }

  .faq-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: var(--s-7); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: var(--s-5); } }
  .faq { border-top: 1px solid var(--mx-hairline); }
  .faq details { border-bottom: 1px solid var(--mx-hairline); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: var(--s-3); padding: 16px 0; font: 600 15px/1.35 var(--font-sans); color: var(--app-text-strong); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; margin-left: auto; font: 400 18px/1 var(--font-mono); color: var(--app-text-subtle); transition: transform var(--t-med) var(--ease-expo); }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { margin: 0 0 18px; max-width: 64ch; font-size: 14.5px; line-height: 1.6; color: var(--app-text-muted); }
</style>
