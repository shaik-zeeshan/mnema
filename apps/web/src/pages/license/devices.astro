---
// Support note for the license device cap — this is the page the license
// server's `reset_url` points at when an activation is refused with
// "device cap reached" (set it to https://mnema.day/license/devices in the
// licensegate console). Everything self-service happens inside the app
// ("Free up my devices" in Settings → About → License & Trial); this page just explains it
// for people who land here from the link. Subject-named route on purpose:
// the page moves you to a new Mac, it doesn't reset anything itself.
//
// Chrome-less like /license/open: Bare.astro, not Base.astro (its release-fetch
// machinery is dead weight here).
import Bare from "../../layouts/Bare.astro";
---

<Bare
  title="Move Mnema to a new Mac"
  description="Your Mnema license works on up to 3 Macs. Free them up from inside the app to move to a new one."
>
  <div class="card mx-panel">
    <a class="card__logo" href="/"><img src="/icon.png" alt="Mnema" width="44" height="44" /></a>
    <h1>Move Mnema to a new Mac</h1>
    <p class="mx-prose">
      Your Mnema license works on up to <b>3 Macs</b>. If you just tried to activate
      a new one and were told the limit is reached, you can free up your devices yourself —
      right from the app, no forms, no waiting.
    </p>
    <ol class="steps">
      <li><span>Open Mnema on the Mac you want to use.</span></li>
      <li><span>Go to <span class="path">Settings → About → License &amp; Trial</span>.</span></li>
      <li><span>Click <b>Free up my devices</b>.</span></li>
    </ol>
    <p class="mx-prose">
      That one click clears the license's device list and activates the Mac you're on. To keep
      the limit meaningful, it works once every 30 days — if you reset recently, the app shows
      the date it opens up again.
    </p>
    <hr class="mx-rule" />
    <p class="fine">
      Still stuck? Email <a href="mailto:support@mnema.day">support@mnema.day</a> and we'll sort it out.
    </p>
  </div>
</Bare>

<style>
  .card { max-width: 520px; }
  .card__logo img { border-radius: 10px; }
  .mx-prose { margin: 0 0 var(--s-4); }
  .mx-prose b { color: var(--app-text-strong); font-weight: 600; }

  /* The three steps as settings-style rows: mono number, hairline between. */
  .steps {
    list-style: none; margin: 0 0 var(--s-4); padding: 0; counter-reset: step;
    border: 1px solid var(--app-border); border-radius: var(--r-md); background: var(--app-surface-subtle);
  }
  .steps li {
    display: grid; grid-template-columns: 22px 1fr; align-items: center; gap: var(--s-3); padding: 10px var(--s-3);
    font-size: var(--text-md); line-height: 1.45; color: var(--app-text);
  }
  .steps li + li { border-top: 1px solid var(--mx-hairline); }
  .steps li::before {
    counter-increment: step; content: counter(step); display: grid; place-items: center; width: 22px; height: 22px;
    border-radius: var(--r-xs); box-shadow: inset 0 0 0 1px var(--app-border-strong);
    font: 500 var(--text-xs)/1 var(--font-mono); color: var(--app-text-muted);
  }
  .steps b { color: var(--app-text-strong); font-weight: 600; }

  .mx-rule { margin: var(--s-5) 0; }
  .fine { margin: 0; font-size: var(--text-base); line-height: 1.55; color: var(--app-text-muted); }
  .fine a { color: var(--app-text-strong); text-underline-offset: 2px; }
</style>
