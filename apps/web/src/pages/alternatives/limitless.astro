---
import Compare from "../../layouts/Compare.astro";
import type { Faq, Section } from "../../components/compare/types";
import { PLATFORM_LABEL } from "../../config";

const sections: Section[] = [
  {
    id: "what-happened",
    toc: "What happened",
    kicker: "The short version",
    title: "What happened to Limitless",
    kind: "history",
    rows: [
      {
        when: "2024",
        text: "Limitless began life as Rewind, the Mac app that made “a search engine for your life” a real product category. In 2024 it pivoted to hardware: the Limitless Pendant, a wearable that recorded your conversations and summarized them through a cloud service.",
      },
      {
        when: "Dec 5, 2025",
        text: "On December 5, 2025, Meta acquired the company. Pendant sales ended that day. The service was discontinued in the EU, UK, Brazil, and several other regions, the old Rewind app was shut down, and existing Pendant owners were promised support for at least a year while the team joined Meta's Reality Labs.",
      },
      {
        when: "Now",
        text: "The lesson isn't that Limitless was a bad product — it's that a memory kept in someone else's cloud is only yours until their plans change. If you're replacing it, that's the property to fix first.",
      },
    ],
  },
  {
    id: "criteria",
    toc: "What to look for",
    kicker: "Choosing a replacement",
    title: "What to look for in a replacement",
    intro:
      "A tool that remembers your conversations and your work holds the most personal data you have. Four things worth insisting on.",
    kind: "criteria",
    items: [
      {
        label: "No cloud dependency",
        detail:
          "Limitless stored your conversations in its cloud — which is why an acquisition could shut the service off in whole regions overnight. A local-first tool keeps working no matter who buys whom.",
      },
      {
        label: "No extra hardware",
        detail:
          "A pendant captures what's said around you. Your Mac already sees your meetings, calls, documents, and browsing — software can remember all of it without another device to charge.",
      },
      {
        label: "More than conversations",
        detail:
          "Meeting transcripts are half the story. The other half is what was on screen: the doc you had open, the numbers you saw, the page you can't find again.",
      },
      {
        label: "You control retention and deletion",
        detail:
          "Keep history forever or auto-delete on a schedule, and delete any stretch of it in one click. Your record, your rules — enforced on your machine, not by a service.",
      },
    ],
  },
  {
    id: "comparison",
    toc: "The field",
    kicker: "The field",
    title: "Mnema vs Limitless vs Screenpipe",
    intro: "The core difference isn't features — it's where your memory lives and who can take it away.",
    kind: "field",
    columns: ["Mnema", "Limitless Pendant", "Screenpipe"],
    rows: [
      {
        label: "Status",
        cells: ["Actively developed", "Acquired by Meta — sales ended Dec 2025", "Active (agent-focused)"],
      },
      { label: "Form factor", cells: ["Mac app", "Wearable + cloud app", "Cross-platform app"] },
      {
        label: "Where your data lives",
        cells: ["On your Mac, encrypted search index", "Limitless / Meta cloud", "On your machine"],
      },
      { label: "What it captures", cells: ["Screen, audio, and activity", "Spoken conversations", "Screen and audio"] },
      {
        label: "Ask-AI / chat",
        cells: ["Yes — over your own history", "Yes (cloud)", "Agent-focused (bring your own)"],
      },
      {
        label: "Price",
        cells: ["$69 once, 30-day free trial", "Hardware discontinued", "Free tier; paid from $21/mo"],
      },
    ],
    note: "Competitor details reflect public information as of November 2026 — check each project directly before deciding.",
  },
];

const faqs: Faq[] = [
  {
    q: "What happened to Limitless?",
    a: "Meta acquired Limitless on December 5, 2025. Pendant sales stopped the same day, the service was discontinued in the EU, UK, and several other regions, and the Rewind Mac app was shut down. Existing Pendant owners keep working service for at least a year, with the team folded into Meta's Reality Labs.",
  },
  {
    q: "What is the best Limitless alternative?",
    a: "It depends on what you used it for. If you want a private memory of your work — meetings, calls, documents, everything you saw and heard on your Mac — Mnema covers it on-device with no wearable and no cloud: transcription with speaker labels, timeline scrubbing, search, and ask-AI, with the search index encrypted on disk. If you specifically want a wearable for in-person conversations away from your desk, no Mac app replaces that.",
  },
  {
    q: "Does Mnema record meetings like Limitless did?",
    a: "Yes — Mnema records microphone and system audio on your Mac and transcribes it on-device with speaker labels, so calls and meetings become searchable alongside what was on screen at the time. Nothing is uploaded anywhere.",
  },
  {
    q: "Does Mnema send my recordings to the cloud?",
    a: "No. Capture, text extraction, transcription, and search all run on-device — there's no account, no Mnema cloud, and no telemetry. The one exception is opt-in: you can use your own Deepgram account for higher-accuracy transcripts, and audio leaves your Mac only if you turn that on.",
  },
];
---

<Compare
  title="Limitless alternative — Mnema"
  description="Meta acquired Limitless in December 2025 and Pendant sales stopped. Mnema is a Limitless alternative for Mac: private, on-device memory of your screen and audio — no wearable, no cloud, no subscription."
  slug="limitless"
  hero={{
    kicker: "Limitless alternative",
    title: "A Limitless alternative that no acquisition can switch off.",
    lede: "Limitless sold a memory that lived in its cloud — and when Meta bought the company, whole regions lost it overnight. Mnema is the same promise kept differently: a private memory of everything you see, hear, and do on your Mac, stored on your Mac, with its search index encrypted. No wearable, no account, no subscription.",
    fine: ["reading time ~4 min", ...PLATFORM_LABEL.split(" · ")],
  }}
  sections={sections}
  faqs={faqs}
  ctaTitle="A memory nobody can acquire."
  endLine="local-first · encrypted search index · no account, no Mnema cloud, no telemetry — your record never leaves your Mac."
/>
