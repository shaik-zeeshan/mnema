---
import Compare from "../../layouts/Compare.astro";
import type { Faq, Section } from "../../components/compare/types";
import { PLATFORM_LABEL } from "../../config";

const sections: Section[] = [
  {
    id: "what-happened",
    toc: "What happened",
    kicker: "The short version",
    title: "What happened to Rewind AI",
    kind: "history",
    rows: [
      {
        when: "Late 2022",
        text: "Rewind launched in late 2022 as a Mac app that recorded your screen and audio locally and made it searchable — “the search engine for your life.” For a while it was the reference point for personal screen memory on the Mac.",
      },
      {
        when: "2024",
        text: "In 2024 the company rebranded to Limitless and pivoted to a cloud-based wearable, the Limitless Pendant. The Mac app stopped being the focus.",
      },
      {
        when: "Dec 2025",
        text: "In December 2025, Meta acquired Limitless. The Rewind Mac app shut down on December 19, 2025, Pendant sales stopped, and service was discontinued in the EU and UK, with remaining support winding down through 2026.",
      },
      {
        when: "Now",
        text: "If you relied on Rewind, you're now looking for a replacement — and the shutdown itself is a useful lesson in what to look for next.",
      },
    ],
  },
  {
    id: "criteria",
    toc: "What to look for",
    kicker: "Choosing a replacement",
    title: "What to look for in a replacement",
    intro:
      "A tool that records everything you see and hear is only as good as its answer to one question: who else can see it? Four things worth insisting on.",
    kind: "criteria",
    items: [
      {
        label: "Stays on your Mac",
        detail:
          "Capture, text extraction, transcription, and search should all run on-device, with the searchable history encrypted on disk. If a company can read your history, an acquisition can too, and no acquisition can switch off an app already on your Mac.",
      },
      {
        label: "Captures everything you'd want back",
        detail:
          "Screen, audio, and activity — not just screenshots. The moments you need to recall are as often something said in a call as something on screen.",
      },
      {
        label: "Search plus ask-AI",
        detail:
          "Keyword search finds what you can name; asking an AI about your own past finds what you can only half-describe.",
      },
      {
        label: "You control retention and deletion",
        detail:
          "Keep history forever or auto-delete on a schedule, and delete any stretch of it in one click. Your record, your rules.",
      },
    ],
  },
  {
    id: "comparison",
    toc: "The field",
    kicker: "The field",
    title: "Mnema vs Screenpipe vs ScreenMemory vs OpenRecall",
    intro:
      "These are the main tools people move to after Rewind. All of them keep your data local — the differences are in scope and platform.",
    kind: "field",
    columns: ["Mnema", "Screenpipe", "ScreenMemory", "OpenRecall"],
    rows: [
      { label: "Platform", cells: ["macOS (Apple Silicon)", "Cross-platform", "macOS", "Cross-platform"] },
      { label: "Open source", cells: ["Yes", "Source-available", "No", "Yes"] },
      { label: "Local-first", cells: ["Yes — on-device, encrypted search index", "Yes", "Yes", "Yes"] },
      {
        label: "Audio transcription",
        cells: ["Yes — on-device, with speaker labels", "Yes", "Screen-focused", "Screen-focused"],
      },
      { label: "Ask-AI / chat", cells: ["Yes — over your own history", "Yes (via plugins)", "Search only", "Search-focused"] },
      { label: "Agent / CLI access", cells: ["Yes — brokered, read-only CLI", "Yes (API)", "—", "—"] },
      {
        label: "Price",
        cells: [
          "$69 once, 30-day free trial",
          "Free tier; paid from $21/mo",
          "Free tier; $29 or $39 once",
          "Free (open source)",
        ],
      },
    ],
    note: "Competitor details reflect public information as of November 2026 — check each project directly before deciding.",
  },
];

const faqs: Faq[] = [
  {
    q: "Is Rewind AI still available?",
    a: "No. The Rewind Mac app shut down on December 19, 2025, after Meta acquired Limitless (the company Rewind became). Pendant sales stopped, service was discontinued in the EU and UK, and remaining support winds down through 2026.",
  },
  {
    q: "What is the best Rewind AI alternative for Mac?",
    a: "If you want what Rewind originally promised — a private, searchable record of everything on your Mac — Mnema is the closest match: it captures screen, audio, and activity on-device, encrypts the searchable history on disk, and lets you search it, scrub back to any moment, and ask an AI about it. Screenpipe (source-available) and OpenRecall (open source) are cross-platform options worth a look too.",
  },
  {
    q: "Does Mnema send my recordings to the cloud?",
    a: "No. Capture, text extraction, transcription, and search all run on-device — there's no account, no telemetry, and no Mnema cloud to send anything to. The one exception is opt-in: you can use your own Deepgram account for higher-accuracy transcripts, and audio leaves your Mac only if you turn that on.",
  },
  {
    q: "Can I still use my Rewind data?",
    a: "Rewind stored its recordings locally, so the files may still be on your Mac — but Mnema does not import Rewind archives. Starting with Mnema means starting a fresh record from the day you install it.",
  },
];
---

<Compare
  title="Rewind AI alternative for Mac — Mnema"
  description="Rewind AI shut down in December 2025. Mnema is a Rewind AI alternative for Mac: private, on-device screen and audio memory you can search, scrub, and ask an AI about."
  slug="rewind-ai"
  hero={{
    kicker: "Rewind AI alternative",
    title: "A private Rewind AI alternative that stays on your Mac.",
    lede: "Rewind is gone — the Mac app shut down in December 2025. Mnema picks up where it left off: a local-first screen memory that quietly records your screen, audio, and activity, then lets you search it, scrub back to any moment, and ask an AI about your own past. None of it leaves your Mac.",
    fine: ["reading time ~4 min", ...PLATFORM_LABEL.split(" · ")],
  }}
  sections={sections}
  faqs={faqs}
  ctaTitle="Start a record you actually own."
  endLine="local-first · encrypted search index · no account, no Mnema cloud, no telemetry — your record never leaves your Mac."
/>
