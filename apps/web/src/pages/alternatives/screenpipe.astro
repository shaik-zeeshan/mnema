---
import Compare from "../../layouts/Compare.astro";
import type { Faq, Section } from "../../components/compare/types";
import { PLATFORM_LABEL } from "../../config";

const sections: Section[] = [
  {
    id: "what-changed",
    toc: "Where it landed",
    kicker: "The short version",
    title: "Where Screenpipe has landed",
    kind: "history",
    // No dates in the source story, so the rows are labelled by phase.
    rows: [
      {
        when: "At first",
        text: "Screenpipe earned its following as an open-source, cross-platform engine for 24/7 screen and mic capture — the raw material for a personal AI, with a plugin system to build on top.",
      },
      {
        when: "Since",
        text: "It has since repositioned around AI agents: the pitch today is a local-first context layer you plug into agent frameworks and integrations. Along the way the license moved from MIT to a source-available commercial license, and the signed desktop app moved to paid plans from $21/month (or $250/year), with a free tier.",
      },
      {
        when: "Now",
        text: "None of that is wrong — it's just a different product than a personal memory. If what you wanted was the recall part — find that page, replay that meeting, ask what you worked on last week — you're assembling it yourself from parts. That's the gap Mnema fills.",
      },
    ],
  },
  {
    id: "criteria",
    toc: "What to look for",
    kicker: "Choosing a replacement",
    title: "What to look for in an alternative",
    intro: "A tool that records everything you see and hear is a serious commitment. Four things worth insisting on.",
    kind: "criteria",
    items: [
      {
        label: "Built for recall, not agent plumbing",
        detail:
          "If what you want is to find that thing you saw last Tuesday, you want a polished timeline, search, and ask-AI out of the box — not an API you wire agents into first.",
      },
      {
        label: "Actually open source",
        detail:
          "Source-available licenses let you read the code but restrict what you can do with it. A genuinely open-source license means the community can fork, audit, and keep the project alive.",
      },
      {
        label: "Predictable price",
        detail:
          "A subscription for software that runs entirely on your own machine adds up forever. A one-time purchase means the copy you bought keeps working, whatever happens to the company.",
      },
      {
        label: "Stays on your Mac",
        detail:
          "Capture, text extraction, transcription, and search should all run on-device, with the searchable history encrypted on disk. No account, no Mnema cloud, no telemetry.",
      },
    ],
  },
  {
    id: "comparison",
    toc: "The field",
    kicker: "The field",
    title: "Mnema vs Screenpipe vs OpenRecall",
    intro:
      "All three keep your data local — the differences are in what you get out of the box, the license, and the price.",
    kind: "field",
    columns: ["Mnema", "Screenpipe", "OpenRecall"],
    rows: [
      { label: "Platform", cells: ["macOS (Apple Silicon)", "Cross-platform", "Cross-platform"] },
      { label: "License", cells: ["Open source", "Source-available (commercial license)", "Open source (AGPLv3)"] },
      { label: "Local-first", cells: ["Yes — on-device, encrypted search index", "Yes", "Yes"] },
      { label: "Audio transcription", cells: ["Yes — on-device, with speaker labels", "Yes", "Screen-focused"] },
      {
        label: "Ask-AI / chat",
        cells: ["Yes — over your own history", "Agent-focused (bring your own)", "Search-focused"],
      },
      { label: "Agent / CLI access", cells: ["Yes — brokered, read-only CLI", "Yes (API)", "—"] },
      {
        label: "Price",
        cells: ["$69 once, 30-day free trial", "Free tier; paid from $21/mo", "Free (open source)"],
      },
    ],
    note: "Competitor details reflect public information as of November 2026 — check each project directly before deciding.",
  },
];

const faqs: Faq[] = [
  {
    q: "Is Screenpipe still open source?",
    a: "Not in the usual sense. Screenpipe launched under the MIT license but later moved to a source-available commercial license: personal, non-commercial use stays free, but commercial use requires a paid license, and the signed desktop app has a free tier with paid plans from $21/month ($250/year). Mnema is open source, and the app is a one-time $69 purchase.",
  },
  {
    q: "What is the best Screenpipe alternative for Mac?",
    a: "If you want personal recall — a private, searchable record of what you've seen, heard, and done — Mnema is built exactly for that on the Mac: on-device capture, transcription with speaker labels, timeline scrubbing, search, and ask-AI, with the searchable history encrypted on disk. If you mainly want raw screen data piped into your own agents, Screenpipe's API-first approach may still fit better.",
  },
  {
    q: "How is Mnema different from Screenpipe?",
    a: "Screenpipe has evolved into a context layer for AI agents — you record everything and plug the data into agents and integrations. Mnema is a finished personal-memory app: recording, timeline, search, and ask-AI work out of the box with nothing to assemble, and agents are still served through a brokered, read-only CLI when you want them.",
  },
  {
    q: "Does Mnema send my recordings to the cloud?",
    a: "No. Capture, text extraction, transcription, and search all run on-device — there's no account, no Mnema cloud, and no telemetry. The one exception is opt-in: you can use your own Deepgram account for higher-accuracy transcripts, and audio leaves your Mac only if you turn that on.",
  },
];
---

<Compare
  title="Screenpipe alternative for Mac — Mnema"
  description="Looking for a Screenpipe alternative? Mnema is a fully open-source, one-time-purchase screen memory for Mac: on-device capture, transcription, search, and ask-AI — no subscription."
  slug="screenpipe"
  hero={{
    kicker: "Screenpipe alternative",
    title: "A Screenpipe alternative that's built for recall, not plumbing.",
    lede: "Screenpipe records everything and hands you the data to build with. Mnema records everything and hands you the answers: a Mac-native timeline you can scrub, search, and ask an AI about — on-device, with an encrypted search index, open source, and yours for a one-time purchase.",
    fine: ["reading time ~4 min", ...PLATFORM_LABEL.split(" · ")],
  }}
  sections={sections}
  faqs={faqs}
  ctaTitle="Recall that works out of the box."
  endLine="local-first · encrypted search index · no account, no Mnema cloud, no telemetry — your record never leaves your Mac."
/>
