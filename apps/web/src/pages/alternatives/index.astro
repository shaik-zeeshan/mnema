---
// Hub for the /alternatives/* comparison pages. Exists because Google
// path-truncates discovered URLs and was hitting a 404 on the bare directory —
// and because the four comparisons were only reachable from the footer.
import Base from "../../layouts/Base.astro";
import TopBar from "../../components/TopBar.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/compare/Hero.astro";

const pageTitle = "Mnema vs Rewind, Recall, Limitless, and Screenpipe";
const pageDescription =
  "How Mnema compares to Rewind AI, Microsoft Recall, Limitless, and Screenpipe — private, on-device screen and audio memory for Mac, one-time purchase, fully open source.";

const comparisons = [
  {
    label: "Rewind AI alternative",
    detail:
      "Rewind AI shut down in December 2025. Mnema keeps capture, transcription, and search on your Mac, so no acquisition can switch your history off.",
    href: "/alternatives/rewind-ai/",
  },
  {
    label: "Microsoft Recall for Mac",
    detail:
      "Recall is a Windows 11 Copilot+ feature and doesn't exist for macOS. Mnema brings the same idea — continuous capture, searchable screen history, ask-AI — to your Mac.",
    href: "/alternatives/microsoft-recall-mac/",
  },
  {
    label: "Limitless alternative",
    detail:
      "Meta acquired Limitless and Pendant sales stopped. Mnema needs no wearable: your Mac already sees the meetings, calls, and documents worth remembering.",
    href: "/alternatives/limitless/",
  },
  {
    label: "Screenpipe alternative",
    detail:
      "Screenpipe is plumbing you wire agents into. Mnema ships the recall product itself — timeline, search, and ask-AI — fully open source, one-time purchase.",
    href: "/alternatives/screenpipe/",
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <TopBar />
  <main>
    <Hero
      kicker="Comparisons"
      title="How Mnema compares"
      lede="Screen memory has had a rough couple of years — one shutdown, one acquisition, one feature that never came to the Mac. Here's how Mnema lines up against each of them."
      fine={["on-device", "open source", "one-time purchase"]}
    />

    <section class="w-sec w-sec--rule" aria-labelledby="comparisons">
      <div class="w-wrap pick">
        <div class="pick__head w-stack">
          <span class="mx-kicker">Pick a comparison</span>
          <h2 class="w-title" id="comparisons">Coming from something else?</h2>
        </div>
        <ul class="alts">
          {
            comparisons.map((c, i) => (
              <li>
                <a class="alt" href={c.href}>
                  <span class="w-meta">{String(i + 1).padStart(2, "0")}</span>
                  <div>
                    <h3 class="w-sub">{c.label}</h3>
                    <p class="w-prose">{c.detail}</p>
                  </div>
                  <span class="mx-btn mx-btn--sm">Read the comparison →</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* A heading rail + one hairline row per comparison page (no cards); the
     whole row is the link, the button is just its signifier. */
  .pick { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); gap: var(--s-7); }
  .pick__head { position: sticky; top: 96px; align-self: start; }
  @media (max-width: 900px) { .pick { grid-template-columns: 1fr; gap: var(--s-5); } .pick__head { position: static; } }

  .alts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--mx-hairline); }
  .alt { display: grid; grid-template-columns: 36px minmax(0, 1fr) auto; gap: var(--s-2) var(--s-4); align-items: start;
    padding: var(--s-5) 0; border-bottom: 1px solid var(--mx-hairline); text-decoration: none; color: inherit;
    transition: background-color var(--t-fast) var(--ease-quart); }
  .alt:hover { background: var(--mx-wash); }
  .alt:hover .mx-btn { --_fg: var(--app-text-strong); }
  .alt > .w-meta { color: var(--app-text-faint); padding-top: 5px; }
  .alt .w-sub { margin-bottom: 6px; }
  .alt .mx-btn { pointer-events: none; margin-top: 1px; }
  @media (max-width: 640px) { .alt { grid-template-columns: 28px minmax(0, 1fr); } .alt .mx-btn { grid-column: 2; justify-self: start; } }
</style>
