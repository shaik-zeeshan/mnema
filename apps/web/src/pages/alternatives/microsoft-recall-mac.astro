---
import Compare from "../../layouts/Compare.astro";
import type { Faq, Section } from "../../components/compare/types";
import { PLATFORM_LABEL } from "../../config";

const sections: Section[] = [
  {
    id: "direct-answer",
    toc: "Short answer",
    kicker: "The short answer",
    title: "Is there a Microsoft Recall for Mac?",
    kind: "prose",
    paras: [
      "No. Recall is a Windows 11 feature exclusive to Copilot+ PCs — it needs an NPU-equipped machine, where it periodically snapshots your screen and makes those snapshots searchable. Apple ships nothing equivalent on macOS: no built-in screen history, no “scroll back through your day.” If you want that on a Mac, it has to come from a third-party app.",
    ],
  },
  {
    id: "what-mnema-does",
    toc: "What Mnema does",
    kicker: "The equivalent",
    title: "What Mnema does on your Mac.",
    intro: "Mnema covers Recall's promise — and goes further, because it also hears what Recall only sees.",
    kind: "criteria",
    items: [
      {
        label: "Continuous capture",
        detail:
          "Mnema records your screen, audio, and activity into a private personal record — the same always-on snapshot idea Recall promises, running natively on macOS.",
      },
      {
        label: "Search everything you've seen",
        detail:
          "Text is read from your screen on-device (OCR) and audio is transcribed locally, so you can search anything that ever crossed your screen or your meetings.",
      },
      {
        label: "Scrub the timeline",
        detail:
          "Rewind through your own history like a video — jump to the exact moment you half-remember and see it again.",
      },
      {
        label: "Ask AI about your history",
        detail:
          "Ask questions in plain language and get answers grounded in your own record. Local AI agents can get read-only, brokered access too.",
      },
    ],
  },
  {
    id: "privacy",
    toc: "Privacy",
    kicker: "Privacy",
    title: "Private by construction, not by patch.",
    kind: "prose",
    paras: [
      "Recall drew heavy criticism at its 2024 launch for storing screen snapshots insecurely. Microsoft delayed it and reworked the design — it's now opt-in, gated behind Windows Hello, and encrypted. Fair enough; the concerns were addressed after the fact.",
      "Mnema starts from the other end. Capture, text extraction, transcription, and search all run on your Mac — no account, no telemetry, no Mnema cloud to send anything to. The searchable history (every word, transcript, and page name) is encrypted on disk with a key in your Keychain, passwords, keys, and card numbers Mnema recognises are stripped from searchable text, and you hold every control: keep history forever or auto-delete after 7, 14, or 30 days, exclude any app from recording, and wipe recent capture in one click.",
    ],
  },
  {
    id: "comparison",
    toc: "Side by side",
    kicker: "Side by side",
    title: "Recall, Mnema, and the other local options.",
    kind: "field",
    columns: ["Mnema", "Windows Recall", "OpenRecall", "Screenpipe"],
    rows: [
      { label: "Platform", cells: ["macOS", "Windows 11", "Windows, macOS, Linux", "Windows, macOS, Linux"] },
      {
        label: "Hardware",
        cells: ["Apple Silicon Mac", "Copilot+ PC with an NPU", "Standard hardware", "Standard hardware"],
      },
      { label: "Local-only storage", cells: ["Yes — no account, no Mnema cloud", "Yes", "Yes", "Yes"] },
      { label: "Audio capture", cells: ["Yes — mic and system audio", "No", "No", "Yes"] },
      {
        label: "Ask AI over history",
        cells: ["Yes — ask AI, plus agent access", "Search", "Search", "Yes — via plugins"],
      },
    ],
    note: "Competitor details are kept deliberately general — check each project for current specifics.",
  },
];

const faqs: Faq[] = [
  {
    q: "Does Apple have a Recall feature?",
    a: "No. macOS ships nothing equivalent to Windows Recall. Spotlight searches your files, but nothing built into macOS records what was on your screen or lets you search it later. Mnema is a third-party Mac app that fills exactly that gap.",
  },
  {
    q: "Is Mnema private?",
    a: "Yes. Capture, text extraction, transcription, and search all run on your Mac — no account, no telemetry, and no Mnema cloud to send anything to. The searchable history is encrypted on disk with a key in your Keychain, passwords, keys, and card numbers Mnema recognises are stripped from it, you choose how long history is kept, and you can exclude apps or delete recent capture in one click.",
  },
  {
    q: "Does Mnema work on Intel Macs?",
    a: "Not today. Mnema currently ships builds for Apple Silicon Macs only — there is no Intel build.",
  },
];
---

<Compare
  title="Microsoft Recall for Mac? Mnema is the Mac equivalent"
  description="There's no Microsoft Recall for Mac — Recall is a Windows 11 Copilot+ PC feature. Mnema brings the same idea to macOS: continuous capture, searchable screen history, timeline scrubbing, and ask-AI — private and on-device."
  slug="microsoft-recall-mac"
  hero={{
    kicker: "Recall, for Mac",
    title: "There's no Microsoft Recall for Mac. Mnema is the Mac equivalent.",
    lede: "Recall is a Windows-only feature, and Apple ships nothing like it. Mnema is the same idea — a searchable record of everything you've seen — built Mac-native and private: everything stays on your machine.",
    fine: [...PLATFORM_LABEL.split(" · "), "open source", "30-day free trial"],
  }}
  sections={sections}
  faqs={faqs}
  faqTitle="Common questions."
  ctaTitle="Recall, the Mac way."
  endLine="everything on-device: capture, OCR, transcription, search, and storage — an encrypted search index, retention and deletion in your hands."
/>
