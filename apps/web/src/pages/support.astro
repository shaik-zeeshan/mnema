---
import Base from "../layouts/Base.astro";
import TopBar from "../components/TopBar.astro";
import Footer from "../components/Footer.astro";
import { GITHUB_URL } from "../config";

const pageTitle = "mnema — support";
const pageDescription =
  "Get help with Mnema. Email support@mnema.day, report bugs on GitHub, or manage your license and devices yourself.";

const channels = [
  {
    label: "Bug or crash?",
    detail:
      "Open an issue on GitHub — it's the fastest way to get a fix into a release, and other users can find it too.",
    href: `${GITHUB_URL}/issues`,
    cta: "Open a GitHub issue",
    external: true,
  },
  {
    label: "New Mac refused — device limit reached?",
    detail:
      "Your license works on up to 3 Macs at a time. If a new one was refused because all 3 are used, you can free them up yourself from inside the app.",
    href: "/license/devices/",
    cta: "Free up your devices",
    external: false,
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <TopBar />
  <main>
    <section class="hero w-texture">
      <div class="w-wrap hero__grid">
        <div>
          <span class="mx-kicker w-in">Support</span>
          <h1 class="w-display w-in" style="--d:60ms">Need a hand?</h1>
          <p class="w-lede w-in" style="--d:120ms">
            A real person reads every email. Purchases, refunds, licenses, or
            anything you can't figure out — write to us and we'll sort it out.
          </p>
          <p class="w-meta w-in" style="--d:150ms">
            replies from a human, usually within a day
          </p>
        </div>
        <div class="mx-panel mail w-in" style="--d:180ms" aria-labelledby="email">
          <span class="mx-kicker" id="email">Email us</span>
          <a class="mail__addr" href="mailto:support@mnema.day">support@mnema.day</a>
          <p class="w-prose">
            Include your macOS version and the Mnema version (shown in
            <span class="path">Settings → About</span>) — it saves a round trip.
          </p>
        </div>
      </div>
    </section>

    <section class="w-sec w-sec--rule" aria-labelledby="other-channels">
      <div class="w-wrap">
        <div class="col">
          <div class="head">
            <span class="mx-kicker">Or go direct</span>
            <h2 class="w-title" id="other-channels">Some things are faster elsewhere</h2>
          </div>
          <div class="rows">
            {
              channels.map((c) => (
                <div class="srow">
                  <div>
                    <div class="srow__label">{c.label}</div>
                    <p class="srow__desc">{c.detail}</p>
                  </div>
                  <a
                    class="mx-btn"
                    href={c.href}
                    {...(c.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    {c.cta} →
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Hero with the email card beside it, then the faster channels as app
     Settings rows (copy left, action right, hairline between). */
  .col {
    max-width: 760px;
  }
  .hero {
    padding-top: clamp(56px, 9vw, 112px);
    padding-bottom: clamp(40px, 6vw, 72px);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--s-7);
    align-items: end;
  }
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
  .hero .w-display {
    margin-top: var(--s-4);
    max-width: 14ch;
  }
  .hero .w-lede {
    margin-top: var(--s-4);
  }
  .hero .w-meta {
    margin-top: var(--s-5);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero .w-meta::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 1px;
    background: var(--app-text-faint);
  }

  .mail {
    padding: clamp(20px, 3vw, 28px);
    display: grid;
    gap: var(--s-3);
  }
  .mail__addr {
    justify-self: start;
    max-width: 100%;
    overflow-wrap: anywhere;
    font: 400 clamp(20px, 2.4vw, 26px) / 1.25 var(--font-mono);
    letter-spacing: -0.02em;
    color: var(--app-text-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--app-accent-border);
    transition:
      color var(--t-fast) var(--ease-quart),
      border-color var(--t-fast) var(--ease-quart);
  }
  .mail__addr:hover {
    color: var(--app-accent);
    border-color: var(--app-accent);
  }
  .mail .w-prose {
    font-size: 14px;
    max-width: 54ch;
  }
  .path {
    font: 450 0.86em/1 var(--font-mono);
    color: var(--app-text-strong);
    white-space: nowrap;
    padding: 2px 6px;
    border-radius: var(--r-sm);
    background: var(--app-surface-subtle);
    box-shadow: inset 0 0 0 1px var(--app-border);
  }

  .head {
    display: grid;
    gap: var(--s-3);
    margin-bottom: var(--s-5);
  }
  .rows {
    border-top: 1px solid var(--app-border);
  }
  .srow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-6);
    padding: 18px 0;
    border-bottom: 1px solid var(--mx-hairline);
  }
  .srow__label {
    font: 600 15px/1.35 var(--font-sans);
    color: var(--app-text-strong);
  }
  .srow__desc {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--app-text-muted);
    max-width: 58ch;
  }
  .srow .mx-btn {
    white-space: nowrap;
  }
  @media (max-width: 600px) {
    .srow {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
    .srow .mx-btn {
      justify-self: start;
    }
  }
</style>
